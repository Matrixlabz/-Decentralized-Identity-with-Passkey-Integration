{
  "name": "@decentralized-identity/smart-contracts",
  "version": "1.0.0",
  "description": "Stellar smart contracts for decentralized identity platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "ts-node scripts/deploy.ts",
    "deploy:testnet": "ts-node scripts/deploy.ts --network testnet",
    "deploy:mainnet": "ts-node scripts/deploy.ts --network mainnet",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^11.0.0",
    "@stellar/stellar-base": "^11.0.0",
    "@decentralized-identity/shared": "*",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.3",
    "ts-jest": "^29.1.1",
    "eslint": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1"
  }
}
